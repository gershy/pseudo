{
  
  "name": "@gershy/pseudo",
  "version": "0.0.2",
  "author": "Gershom Maes",
  "repository": { "type": "git", "url": "git+https://github.com/gershy/pseudo.git" },
  
  "engines": { "node": ">=22.0.0" },
  
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  
  "type": "module",
  "files": [ "npm" ],
  "main":  "./npm/pseudo.js",
  "types": "./npm/pseudo.d.ts",
  "exports": {
    ".": {
      "import": "./npm/pseudo.js",
      "types":  "./npm/pseudo.d.ts"
    }
  },
  
  "scripts": {
    
    "npmDelete": "node -e \"fs.rmSync('./npm', { recursive: true, force: true })\"",
    "npmBundle": "tsc --project tsconfig.json",
    "npmShip": "npm whoami && npm run npmDelete && npm run npmBundle && npm publish --access public",
    
    ".to ship with cli otp": "npm run npmShip -- --otp 123456"
    
  }
  
}
